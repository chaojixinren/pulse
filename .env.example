# ==================== Pulse 部署环境变量 ====================
# 用法：cp .env.example .env 后按需填写，再 docker compose up -d --build
# 注意：docker compose 读取的是仓库根目录的 .env（不是 backend/.env）。

# --- MySQL（mysql 容器用这些变量初始化数据库与账号） ---
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=pulse
MYSQL_USER=pulse
MYSQL_PASSWORD=change-me-pulse-password

# --- 后端连接串（通常无需手动设置：compose 会自动用上面的 MYSQL_USER/MYSQL_PASSWORD/MYSQL_DATABASE 拼出。
#      如需连接外部 MySQL，取消注释并覆盖即可） ---
# DATABASE_DSN=pulse:change-me-pulse-password@tcp(mysql:3306)/pulse?charset=utf8mb4&parseTime=True&loc=Local

# --- 认证 ---
# 生产务必替换为随机长字符串（生成：openssl rand -hex 32）
JWT_SECRET=change-me-to-a-long-random-secret
GIN_MODE=release

# --- STT 转写（StepFun StepAudio-2.5-ASR）---
STEPFUN_API_KEY=
STEPFUN_API_BASE=https://api.stepfun.com/v1
STEPFUN_STT_MODEL=stepaudio-2.5-asr

# --- AI 分析（adk-go / OpenAI 兼容：身份识别 + 待办/承诺/笔记提取）---
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_CONFIDENCE_THRESHOLD=0.6

# --- 音频加密存储（AES-256-GCM）---
# 32 字节密钥的 base64 编码；留空关闭加密（生产建议配置）。生成：openssl rand -base64 32
AUDIO_ENCRYPTION_KEY=

# --- 其它 ---
LOG_LEVEL=info
ALLOWED_ORIGINS=
FRONTEND_PORT=5173
