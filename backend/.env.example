# 服务配置
PORT=8080
GIN_MODE=debug

# 数据库
DATABASE_URL=postgresql://user:password@localhost:5432/pulse
REDIS_URL=redis://localhost:6379

# 对象存储（选择一个）
# AWS S3
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
S3_BUCKET=pulse-audio

# 或阿里云 OSS
# ALIYUN_ACCESS_KEY_ID=your_aliyun_key
# ALIYUN_ACCESS_KEY_SECRET=your_aliyun_secret
# ALIYUN_OSS_REGION=oss-cn-hangzhou
# ALIYUN_OSS_BUCKET=pulse-audio

# AI 服务 (adk-go + eino)
AI_API_KEY=your_ai_api_key
AI_BASE_URL=https://api.example.com

# STT 服务 (StepFun StepAudio-2.5-ASR)
STEPFUN_API_KEY=your_stepfun_api_key
STEPFUN_STT_MODEL=stepaudio-2.5-asr
STEPFUN_API_BASE=https://api.stepfun.com/v1

# JWT 密钥
JWT_SECRET=your_random_secret_key_change_in_production
JWT_EXPIRES_IN=168h

# CORS 配置
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 日志级别
LOG_LEVEL=info

# 语音处理配置
MAX_AUDIO_SIZE=52428800
AUDIO_RETENTION_DAYS=30
